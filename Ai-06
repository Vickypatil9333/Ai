visited = set()

def dfs(a, b):
    if (a, b) in visited:
        return False

    visited.add((a, b))
    print((a, b))

    if a == 2 or b == 2:
        print("Goal Reached")
        return True

    # Fill either jug
    if dfs(4, b):
        return True
    if dfs(a, 3):
        return True

    # Empty either jug
    if dfs(0, b):
        return True
    if dfs(a, 0):
        return True

    # Pour jug 2 into jug 1
    transfer = min(b, 4 - a)
    if dfs(a + transfer, b - transfer):
        return True

    # Pour jug 1 into jug 2
    transfer = min(a, 3 - b)
    if dfs(a - transfer, b + transfer):
        return True

    return False

if not dfs(0, 0):
    print("No solution found")
