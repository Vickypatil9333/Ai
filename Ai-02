import heapq

start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

moves = {
    0: [1, 3],
    1: [0, 2, 4],
    2: [1, 5],
    3: [0, 4, 6],
    4: [1, 3, 5, 7],
    5: [2, 4, 8],
    6: [3, 7],
    7: [4, 6, 8],
    8: [5, 7],
}

def heuristic(state):
    distance = 0

    for index, tile in enumerate(state):
        if tile != 0:
            goal_index = goal.index(tile)
            row, col = divmod(index, 3)
            goal_row, goal_col = divmod(goal_index, 3)
            distance += abs(row - goal_row) + abs(col - goal_col)

    return distance


open_list = [(heuristic(start), 0, start)]
best_cost = {start: 0}
parent = {start: None}

while open_list:
    _, cost, current = heapq.heappop(open_list)

    if cost != best_cost[current]:
        continue

    if current == goal:
        print("Goal Reached")
        break

    blank = current.index(0)

    for target in moves[blank]:
        neighbor = list(current)
        neighbor[blank], neighbor[target] = neighbor[target], neighbor[blank]
        neighbor = tuple(neighbor)

        new_cost = cost + 1

        if new_cost < best_cost.get(neighbor, float("inf")):
            best_cost[neighbor] = new_cost
            parent[neighbor] = current
            priority = new_cost + heuristic(neighbor)
            heapq.heappush(open_list, (priority, new_cost, neighbor))
else:
    print("No solution found")
    raise SystemExit

# Rebuild and print the path from start to goal
path = []
state = goal
while state is not None:
    path.append(state)
    state = parent[state]

for state in reversed(path):
    print(state[:3])
    print(state[3:6])
    print(state[6:])
    print()
