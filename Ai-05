from collections import deque

start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

moves = {
    0: [1, 3],
    1: [0, 2, 4],
    2: [1, 5],
    3: [0, 4, 6],
    4: [1, 3, 5, 7],
    5: [2, 4, 8],
    6: [3, 7],
    7: [4, 6, 8],
    8: [5, 7],
}

queue = deque([start])
visited = {start}
parent = {start: None}

while queue:
    current = queue.popleft()

    if current == goal:
        print("Goal Reached")
        break

    blank = current.index(0)

    for target in moves[blank]:
        neighbor = list(current)
        neighbor[blank], neighbor[target] = neighbor[target], neighbor[blank]
        neighbor = tuple(neighbor)

        if neighbor not in visited:
            visited.add(neighbor)
            parent[neighbor] = current
            queue.append(neighbor)
else:
    print("No solution found")
    raise SystemExit

# Rebuild and print the path from start to goal
path = []
state = goal
while state is not None:
    path.append(state)
    state = parent[state]

for state in reversed(path):
    print(state[:3])
    print(state[3:6])
    print(state[6:])
    print()
