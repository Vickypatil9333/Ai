def alphabeta(depth, node, max_player, values, alpha, beta):
    if depth == 2:
        return values[node]

    if max_player:
        best = float("-inf")

        for i in range(2):
            value = alphabeta(
                depth + 1, node * 2 + i, False,
                values, alpha, beta
            )
            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    best = float("inf")

    for i in range(2):
        value = alphabeta(
            depth + 1, node * 2 + i, True,
            values, alpha, beta
        )
        best = min(best, value)
        beta = min(beta, best)

        if beta <= alpha:
            break

    return best


values = [2, 4, 5, 10]

if len(values) != 2 ** 2:
    raise ValueError("This example needs 4 leaf values for depth 2.")

result = alphabeta(0, 0, True, values, float("-inf"), float("inf"))
print("Optimal Value =", result)
